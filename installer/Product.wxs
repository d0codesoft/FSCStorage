<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
	<Package
	  Name="!(loc.ProductName)"
	  Manufacturer="SCP"
	  Version="$(var.ProductVersion)"
	  UpgradeCode="{2F26E8C4-7D37-48F8-9635-45683C7D53E5}"
	  Codepage="65001"
	  Scope="perMachine">

		<!-- Dev builds often reuse ProductVersion, so same-version MSI builds must replace older ProductCodes instead of adding ARP entries. -->
		<MajorUpgrade
		  DowngradeErrorMessage="!(loc.DowngradeErrorMessage)"
		  AllowSameVersionUpgrades="yes" />
		<MediaTemplate EmbedCab="yes" />
		<Launch Condition="Privileged" Message="!(loc.AdminPrivilegesRequiredMessage)" />

		<!--
        Standard WixUI_InstallDir UI.
        The custom ServiceAccountDlg is inserted between InstallDirDlg and VerifyReadyDlg below.
        -->
		<ui:WixUI Id="FscStorage_InstallDir" InstallDirectory="INSTALLFOLDER" />

		<WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)assets\license.rtf" />
		<WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)assets\dialog.png" />
		<WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)assets\banner.png" />

		<!-- Service installation properties. Public properties are uppercase. -->
		<Property Id="INSTALL_AS_SERVICE" Value="1" Secure="yes" />
		<Property Id="START_SERVICE" Value="1" Secure="yes" />
		<Property Id="CHANGE_CONFIG" Value="0" Secure="yes" />
		<Property Id="UPGRADE_ACTION" Value="UPGRADE" Secure="yes" />
		<Property Id="TRANSPORT_MODE" Value="HTTP" Secure="yes" />
		<Property Id="EXISTING_PFX_PATH" Secure="yes" />
		<Property Id="EXISTING_PFX_PASSWORD" Secure="yes" Hidden="yes" />
		<Property Id="SELF_SIGNED_DNS_NAMES" Value="localhost" Secure="yes" />
		<Property Id="SELF_SIGNED_PFX_PASSWORD" Secure="yes" Hidden="yes" />

		<!-- SYSTEM / EXISTING / CREATE -->
		<Property Id="SERVICE_ACCOUNT_MODE" Value="SYSTEM" Secure="yes" />

		<Property Id="SERVICEACCOUNT" Value="LocalSystem" Secure="yes" />
		<Property Id="SERVICEPASSWORD" Secure="yes" Hidden="yes" />

		<Property Id="SERVICE_EXISTING_USER" Secure="yes" />
		<Property Id="SERVICE_EXISTING_PASSWORD" Secure="yes" Hidden="yes" />

		<Property Id="SERVICE_CREATE_USER" Value="FSC_USER" Secure="yes" />
		<Property Id="SERVICE_CREATE_PASSWORD" Secure="yes" Hidden="yes" />
		<Property Id="SERVICE_CREATE_PASSWORD_CONFIRM" Secure="yes" Hidden="yes" />

		<Property Id="INSTALLFOLDER">
			<RegistrySearch
			  Id="InstallFolderRegistrySearch"
			  Root="HKLM"
			  Key="Software\SCP\FSCStorage"
			  Name="InstallFolder"
			  Type="raw" />
		</Property>

		<Property Id="DATAFOLDER" Secure="yes">
			<RegistrySearch
			  Id="DataFolderRegistrySearch"
			  Root="HKLM"
			  Key="Software\SCP\FSCStorage"
			  Name="DataFolder"
			  Type="raw" />
		</Property>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="FSCStorage" />
		</StandardDirectory>
		<StandardDirectory Id="CommonAppDataFolder">
			<Directory Id="DATAFOLDER" Name="FSCStorage" />
		</StandardDirectory>

		<Feature Id="MainFeature" Title="!(loc.ProductName)" Level="1">
			<ComponentRef Id="DataFolderComponent" />
			<ComponentRef Id="InstallFolderRegistryComponent" />
			<ComponentRef Id="InstallFolderCleanupComponent" />
			<ComponentRef Id="AppSettingsComponent" />
			<ComponentRef Id="InstallerToolComponent" />
			<ComponentRef Id="ServiceComponent" />
			<ComponentRef Id="StartServiceComponent" />
			<ComponentRef Id="FscStorageServiceUserComponent" />
			<ComponentGroupRef Id="PublishedFiles" />
		</Feature>

		<SetProperty
			Id="ConfigureTransport"
			Value="&quot;[#InstallerToolExe]&quot; -i &quot;[INSTALLFOLDER].&quot; -m &quot;[TRANSPORT_MODE]&quot; -x &quot;[EXISTING_PFX_PATH]&quot; -xp &quot;[EXISTING_PFX_PASSWORD]&quot; -gp &quot;[SELF_SIGNED_PFX_PASSWORD]&quot; -n &quot;[SELF_SIGNED_DNS_NAMES]&quot;"
			Before="ConfigureTransport"
			Sequence="execute" />

		<SetProperty
			Id="BackupAppSettings"
			Value="&quot;[SystemFolder]cmd.exe&quot; /d /c if exist &quot;[INSTALLFOLDER]appsettings.json&quot; copy /y &quot;[INSTALLFOLDER]appsettings.json&quot; &quot;[TempFolder]FSCStorage.appsettings.backup.json&quot; &gt;NUL"
			Before="BackupAppSettings"
			Sequence="execute" />

		<SetProperty
			Id="RestoreAppSettings"
			Value="&quot;[SystemFolder]cmd.exe&quot; /d /c if exist &quot;[TempFolder]FSCStorage.appsettings.backup.json&quot; copy /y &quot;[TempFolder]FSCStorage.appsettings.backup.json&quot; &quot;[INSTALLFOLDER]appsettings.json&quot; &gt;NUL"
			Before="RestoreAppSettings"
			Sequence="execute" />

		<SetProperty
			Id="CleanUpgradeBinaries"
			Value="&quot;[SystemFolder]cmd.exe&quot; /d /c for /r &quot;[INSTALLFOLDER].&quot; %F in (*.dll *.exe) do del /f /q &quot;%F&quot;"
			Before="CleanUpgradeBinaries"
			Sequence="execute" />

		<SetProperty
			Id="LaunchInstalledVersionRepair"
			Value="&quot;[SystemFolder]msiexec.exe&quot; /fa [WIX_UPGRADE_DETECTED] REINSTALLMODE=amus"
			Before="LaunchInstalledVersionRepair"
			Sequence="ui" />

		<CustomAction
		  Id="ConfigureTransport"
		  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
		  DllEntry="WixSilentExec"
		  Execute="deferred"
		  Impersonate="no"
		  Return="check"
		  HideTarget="yes" />

		<CustomAction
		  Id="BackupAppSettings"
		  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
		  DllEntry="WixSilentExec"
		  Execute="immediate"
		  Return="check"
		  HideTarget="yes" />

		<CustomAction
		  Id="RestoreAppSettings"
		  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
		  DllEntry="WixSilentExec"
		  Execute="deferred"
		  Impersonate="no"
		  Return="check"
		  HideTarget="yes" />

		<CustomAction
		  Id="CleanUpgradeBinaries"
		  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
		  DllEntry="WixSilentExec"
		  Execute="deferred"
		  Impersonate="no"
		  Return="check"
		  HideTarget="yes" />

		<CustomAction
		  Id="LaunchInstalledVersionRepair"
		  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
		  DllEntry="WixSilentExec"
		  Execute="immediate"
		  Return="check"
		  HideTarget="yes" />

		<InstallExecuteSequence>
			<Custom Action="BackupAppSettings" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
			<Custom Action="CleanUpgradeBinaries" Before="InstallFiles" Condition="WIX_UPGRADE_DETECTED AND NOT Installed AND UPGRADE_ACTION=&quot;UPGRADE&quot;" />
			<Custom Action="RestoreAppSettings" After="InstallFiles" Condition="WIX_UPGRADE_DETECTED AND NOT Installed" />
			<Custom Action="ConfigureTransport" After="InstallFiles" Condition="(NOT Installed AND NOT WIX_UPGRADE_DETECTED) OR CHANGE_CONFIG=&quot;1&quot;" />
		</InstallExecuteSequence>

		<InstallUISequence>
			<Custom Action="LaunchInstalledVersionRepair" After="AppSearch" Condition="0" />
		</InstallUISequence>
	</Package>
</Wix>
