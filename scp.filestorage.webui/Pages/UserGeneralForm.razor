@inject AdminApiClient ApiClient
@inject NavigationManager Navigation

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter">
        @statusMessage
    </RadzenAlert>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
        @errorMessage
    </RadzenAlert>
}

<RadzenTemplateForm TItem="UserProfileEditorModel" Data="@model" Submit="@SaveAsync">
    <DataAnnotationsValidator />

    <div class="admin-form-grid">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenLabel Component="UserNameInput">
                <RadzenIcon Icon="person" class="rz-mr-1" /> Username
            </RadzenLabel>
            <RadzenTextBox Name="UserNameInput" @bind-Value="model.Name" Disabled="@isBusy" Style="width: 100%;" />
            <ValidationMessage For="@(() => model.Name)" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenLabel Component="EmailInput">
                <RadzenIcon Icon="email" class="rz-mr-1" /> Email
            </RadzenLabel>
            <RadzenTextBox Name="EmailInput" @bind-Value="model.Email" Disabled="@isBusy" Style="width: 100%;" />
            <ValidationMessage For="@(() => model.Email)" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenLabel Component="PhoneInput">
                <RadzenIcon Icon="call" class="rz-mr-1" /> Phone
            </RadzenLabel>
            <RadzenTextBox Name="PhoneInput" @bind-Value="model.PhoneNumber" Disabled="@isBusy" Style="width: 100%;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenLabel Component="ExternalUserIdInput">
                <RadzenIcon Icon="badge" class="rz-mr-1" /> External ID
            </RadzenLabel>
            <RadzenTextBox Name="ExternalUserIdInput" @bind-Value="model.ExternalUserId" Disabled="@isBusy" Style="width: 100%;" />
        </RadzenStack>
    </div>

    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" class="rz-mb-4">
        <RadzenLabel Component="CommentInput">
            <RadzenIcon Icon="notes" class="rz-mr-1" /> Comment
        </RadzenLabel>
        <RadzenTextArea Name="CommentInput" @bind-Value="model.Comment" Disabled="@isBusy" Rows="4" Style="width: 100%;" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
        <RadzenBadge BadgeStyle="@(User.IsActive ? BadgeStyle.Success : BadgeStyle.Secondary)" Text="@(User.IsActive ? "Active" : "Inactive")" />
        <RadzenBadge BadgeStyle="@(User.IsLocked ? BadgeStyle.Warning : BadgeStyle.Light)" Text="@(User.IsLocked ? "Locked" : "Unlocked")" />
        @if (!string.IsNullOrWhiteSpace(User.Email))
        {
            <RadzenBadge BadgeStyle="@(User.EmailConfirmed ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(User.EmailConfirmed ? "Email verified" : "Email unverified")" />
        }
        @if (User.PhoneNumber is not null)
        {
            <RadzenBadge BadgeStyle="@(User.PhoneNumberConfirmed ? BadgeStyle.Success : BadgeStyle.Light)" Text="@(User.PhoneNumberConfirmed ? "Phone confirmed" : "Phone unconfirmed")" />
        }
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" class="user-form-actions">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Disabled="@isBusy" IsBusy="@isBusy" />
            <RadzenButton Text="Reload" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@ReloadAsync" Disabled="@isBusy" />
            @if (!string.IsNullOrWhiteSpace(User.Email) && !User.EmailConfirmed)
            {
                <RadzenButton Text="Verify email" Icon="mark_email_read" ButtonStyle="ButtonStyle.Info" Click="@OpenEmailVerification" Disabled="@isBusy" />
            }
        </RadzenStack>

        @if (CanManageAccount)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton Text="@(User.IsActive ? "Deactivate" : "Activate")"
                              Icon="@(User.IsActive ? "person_off" : "person")"
                              ButtonStyle="@(User.IsActive ? ButtonStyle.Warning : ButtonStyle.Success)"
                              Click="@ToggleActiveAsync"
                              Disabled="@isBusy" />
                <RadzenButton Text="@(User.IsLocked ? "Unlock" : "Lock")"
                              Icon="@(User.IsLocked ? "lock_open" : "lock")"
                              ButtonStyle="ButtonStyle.Warning"
                              Click="@ToggleLockAsync"
                              Disabled="@isBusy" />
            </RadzenStack>
        }
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public UserManagementViewModel User { get; set; } = new();

    [Parameter]
    public bool CanManageAccount { get; set; }

    [Parameter]
    public EventCallback<UserManagementViewModel> UserChanged { get; set; }

    private readonly UserProfileEditorModel model = new();
    private bool isBusy;
    private string? errorMessage;
    private string? statusMessage;

    protected override void OnParametersSet()
    {
        model.Name = User.UserName;
        model.Email = User.Email;
        model.PhoneNumber = User.PhoneNumber;
        model.ExternalUserId = User.ExternalUserId;
        model.Comment = User.Comment;
    }

    private async Task SaveAsync()
    {
        await RunAsync("User profile updated.", async () =>
        {
            var updated = await ApiClient.UpdateUserProfileAsync(User.UserId, new UpdateUserProfileRequestModel
            {
                Name = model.Name,
                Email = model.Email,
                PhoneNumber = model.PhoneNumber,
                ExternalUserId = model.ExternalUserId,
                Comment = model.Comment
            });

            await UserChanged.InvokeAsync(updated);
        });
    }

    private async Task ReloadAsync()
    {
        var updated = await ApiClient.GetUserAsync(User.UserId);
        if (updated is not null)
            await UserChanged.InvokeAsync(updated);
    }

    private void OpenEmailVerification()
    {
        Navigation.NavigateTo($"/users/{User.UserId}/email-verification");
    }

    private async Task ToggleActiveAsync()
    {
        await RunAsync(User.IsActive ? "User deactivated." : "User activated.", async () =>
        {
            if (User.IsActive)
                await ApiClient.DeactivateUserAsync(User.UserId);
            else
                await ApiClient.ActivateUserAsync(User.UserId);

            await ReloadAsync();
        });
    }

    private async Task ToggleLockAsync()
    {
        await RunAsync(User.IsLocked ? "User unlocked." : "User locked.", async () =>
        {
            if (User.IsLocked)
                await ApiClient.UnblockUserAsync(User.UserId);
            else
                await ApiClient.BlockUserAsync(User.UserId);

            await ReloadAsync();
        });
    }

    private async Task RunAsync(string successMessage, Func<Task> action)
    {
        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            await action();
            statusMessage = successMessage;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
