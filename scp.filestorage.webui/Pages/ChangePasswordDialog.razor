@inject DialogService DialogService
@inject scp.filestorage.webui.Services.AdminApiClient ApiClient

<RadzenTemplateForm TItem="ChangePasswordDialogModel" Data="@model" Submit="@SubmitAsync">
    <DataAnnotationsValidator />

    <div class="rz-p-4">
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
                    @errorMessage
                </RadzenAlert>
            }

            <div>
                <RadzenLabel Component="CurrentPasswordInput" Text="Current password" />
                <RadzenPassword Name="CurrentPasswordInput" @bind-Value="model.OldPassword" Disabled="@isBusy" Style="width: 100%;" />
                <ValidationMessage For="@(() => model.OldPassword)" />
            </div>

            <div>
                <RadzenLabel Component="NewPasswordInput" Text="New password" />
                <RadzenPassword Name="NewPasswordInput" @bind-Value="model.NewPassword" Disabled="@isBusy" Style="width: 100%;" />
                <ValidationMessage For="@(() => model.NewPassword)" />
            </div>

            <div>
                <RadzenLabel Component="ChangePasswordConfirmInput" Text="Confirm password" />
                <RadzenPassword Name="ChangePasswordConfirmInput" @bind-Value="model.ConfirmPassword" Disabled="@isBusy" Style="width: 100%;" />
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" Disabled="@isBusy" />
                <RadzenButton Text="Save" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Disabled="@isBusy" IsBusy="@isBusy" />
            </RadzenStack>
        </RadzenStack>
    </div>
</RadzenTemplateForm>

@code {
    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private readonly ChangePasswordDialogModel model = new();
    private string? errorMessage;
    private bool isBusy;

    private Task Cancel()
    {
        DialogService.Close(null);
        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(model.OldPassword))
        {
            errorMessage = "Current password is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.NewPassword))
        {
            errorMessage = "New password is required.";
            return;
        }

        if (!string.Equals(model.NewPassword, model.ConfirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Passwords must match.";
            return;
        }

        isBusy = true;

        try
        {
            await ApiClient.ChangePasswordAsync(new scp.filestorage.webui.Models.ChangePasswordRequestModel
            {
                OldPassword = model.OldPassword,
                NewPassword = model.NewPassword
            });

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ChangePasswordDialogModel
    {
        public string OldPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
